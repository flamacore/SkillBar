# Prefix: Mods.SkillBar.Configs (from filename)

SkillBarConfig: {
	DisplayName: Item Bar

	Headers: {
		GeneralHeader: General
		AppearanceHeader: Appearance
		KeybindsHeader: Keybinds
		InputHeader: Input behavior
	}

	BarOpacity: {
		Label: Bar opacity
		Tooltip: Transparency of the whole item bar (slots, drag handle, key labels, and cooldown numbers). Set to 0% to hide the bar completely (keys still work).
	}

	ShowCooldownOverlay: {
		Label: Show cooldown numbers on slots
		Tooltip: Displays remaining cooldown seconds on a slot. The dark cooldown tint on slots always shows while a slot is on cooldown.
	}

	ShowCooldownChatMessages: {
		Label: Show cooldown chat messages
		Tooltip: Shows "That item is still on cooldown" in chat when you press a slot on cooldown. Turn off to silence those messages only.
	}

	Enabled: {
		Label: Enable item bar
		Tooltip: Turns the item bar and its keybinds on or off.
	}

	ShowKeyLabels: {
		Label: Show bound keys on slots
		Tooltip: Shows the key for each slot on the bar. Set keys below and in Settings > Key Bindings > Item Bar.
	}

	Slot1Key: {
		Label: Slot 1 key (default Z)
		Tooltip: ""
	}

	Slot2Key: {
		Label: Slot 2 key (default X)
		Tooltip: ""
	}

	Slot3Key: {
		Label: Slot 3 key (default C)
		Tooltip: ""
	}

	Slot4Key: {
		Label: Slot 4 key (default V)
		Tooltip: ""
	}

	Slot5Key: {
		Label: Slot 5 key (default B)
		Tooltip: ""
	}

	Slot6Key: {
		Label: Slot 6 key (default N)
		Tooltip: ""
	}

	Slot7Key: {
		Label: Slot 7 key (default M)
		Tooltip: ""
	}

	Slot8Key: {
		Label: Slot 8 key (default comma)
		Tooltip: ""
	}

	Slot9Key: {
		Label: Slot 9 key (default period)
		Tooltip: ""
	}

	Slot10Key: {
		Label: Slot 10 key (default slash)
		Tooltip: ""
	}

	AllowWithInventoryOpen: {
		Label: Allow use while inventory is open
		Tooltip: Lets item bar items fire while the inventory is open.
	}

	AllowWhileChatOpen: {
		Label: Allow use while chat is open
		Tooltip: Lets item bar items fire while the chat box is open. Usually leave off.
	}

	LogKeyPresses: {
		Label: Debug log all item bar input
		Tooltip: Prints a cyan message whenever an item bar slot fires (keyboard or menu keybind).
	}

	AuditWeaponsOnLoad: {
		Label: Audit weapons on load (debug)
		Tooltip: Writes Documents/My Games/Terraria/tModLoader/ItemBar_weapon_audit.txt listing unusual item patterns. Disable after one load.
	}
}
